{
  "name": "@cosyte/ccda",
  "version": "0.1.5",
  "description": "C-CDA parser, serializer, and builder for Node.js and TypeScript: lenient on parse, spec-clean on emit.",
  "keywords": [
    "ccda",
    "c-cda",
    "cda",
    "hl7-cda",
    "ccd",
    "clinical-document",
    "continuity-of-care-document",
    "discharge-summary",
    "referral-note",
    "ehr",
    "healthcare",
    "interoperability",
    "parser",
    "serializer",
    "builder",
    "typescript"
  ],
  "homepage": "https://docs.cosyte.com/ccda",
  "bugs": {
    "url": "https://github.com/cosyte/ccda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/ccda.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "postcss@>=8.0.0 <8.5.26": "8.5.26"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:catalog": "cosyte-catalog",
    "check:claude-card": "cosyte-claude-card",
    "check:readme": "cosyte-readme",
    "check:process": "cosyte-process check",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "conformance": "tsx --max-old-space-size=4096 scripts/conformance/run.ts",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "examples": "tsx scripts/run-examples.ts",
    "check:example-imports": "tsx scripts/check-example-imports.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "node scripts/process-tool.mjs eslint examples --max-warnings=0",
    "clean": "rm -rf dist coverage",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && cosyte-process sync-version && tsx scripts/sync-readme-version.ts && cosyte-process format",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/process": "^0.1.6",
    "@cosyte/script-utils": "^0.1.8",
    "@cosyte/test-utils": "^0.1.3",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "xmllint-wasm": "5.3.0",
    "xpath": "0.0.34"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
